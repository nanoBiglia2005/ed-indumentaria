PRINT_SERVER_WS_URL=ws://localhost:8001/ws/printer
PRINTER_SERVICE_TOKEN=changeme
# Nombre exacto de la impresora (Configuracion > Impresoras y escaneres). Obligatorio
# cuando corre como servicio de Windows: la cuenta LocalSystem no comparte la
# impresora predeterminada del usuario interactivo.
PRINTER_NAME=POS-80
# Ancho del papel en caracteres para el remito (80mm ~ 48, 58mm ~ 32).
PRINTER_COLUMNS=48
