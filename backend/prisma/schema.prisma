generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ARTICULOS {
  id_articulo             Int                       @id(map: "articulos_pk") @default(autoincrement())
  cant                    Int                       @default(0)
  precio                  Float                     @default(0)
  barcode_tail            String?                   @unique(map: "articulos_barcode_tail_idx") @db.VarChar(20)
  stock_minimo            Int                       @default(0) @db.SmallInt
  vigente                 Boolean?                  @default(true)
  id_medida               Int                       @default(1)
  id_proveedor            Int?
  cant_reservada          Int?
  fecha_creacion          DateTime                  @default(now()) @db.Timestamptz(6)
  descripcion             String?                   @db.VarChar(70)
  detalle                 String?                   @db.VarChar(50)
  barcode_old             String?                   @db.VarChar(20)
  talle                   String?                   @db.VarChar(30)
  id_linea                Int?
  id_subgrupo             Int?
  id_grupo                Int                       @default(-1)
  GRUPOS_DE_VENTA         GRUPOS_DE_VENTA           @relation(fields: [id_grupo], references: [id_grupo], onDelete: SetDefault, map: "articulos_grupos_de_venta_fk")
  LINEAS                  LINEAS?                   @relation(fields: [id_linea], references: [id_linea], map: "articulos_lineas_fk")
  PROVEEDORES             PROVEEDORES?              @relation(fields: [id_proveedor], references: [id_proveedor], map: "articulos_proveedores_fk")
  SUBGRUPOS_DE_VENTA      SUBGRUPOS_DE_VENTA?       @relation(fields: [id_subgrupo], references: [id_subgrupo], map: "articulos_subgrupos_de_venta_fk")
  TIPOS_DE_MEDIDA         TIPOS_DE_MEDIDA           @relation(fields: [id_medida], references: [id_medida], onDelete: SetDefault, map: "articulos_tipos_de_medida_fk")
  ARTICULOS_X_CLIENTE     ARTICULOS_X_CLIENTE[]
  ARTICULOS_X_GRUPO_VENTA ARTICULOS_X_GRUPO_VENTA[]
  DETALLES_REMITO         DETALLES_REMITO[]
}

model DETALLES_REMITO {
  id_detalle         Int        @id(map: "_detalles_remito__pk") @default(autoincrement())
  id_remito          Int?
  id_articulo        Int?
  color              String?    @db.VarChar(30)
  medida             String?    @db.VarChar(20)
  observacion        String?    @db.VarChar(40)
  precio             Float?
  bonificacion       Float?
  recargo_financiero Float?
  cantidad           Int?
  ARTICULOS          ARTICULOS? @relation(fields: [id_articulo], references: [id_articulo], map: "_detalles_remito__articulos_fk")
  REMITOS            REMITOS?   @relation(fields: [id_remito], references: [id_remito], onDelete: Cascade, map: "_detalles_remito__remitos_fk")
}

model ESTADOS_REMITOS {
  id_estado     Int       @id(map: "_estados_remitos__pk") @default(autoincrement())
  nombre_estado String?   @db.VarChar(20)
  REMITOS       REMITOS[]
}

model MONEDA {
  id_moneda     Int       @id(map: "_moneda__pk") @default(autoincrement())
  nombre_moneda String?   @db.VarChar(20)
  cotizacion    Float?
  REMITOS       REMITOS[]
}

model NUMERO_REMITO {
  id_numero_remito Int       @id(map: "_numero_remito__pk") @default(autoincrement())
  id_sucursal      Int?
  tipo_comprobante String?   @default("\"remito\"") @db.VarChar(20)
  SUCURSAL         SUCURSAL? @relation(fields: [id_sucursal], references: [id_sucursal], onDelete: Cascade, map: "_numero_remito__sucursal_fk")
}

model PROVEEDORES {
  id_proveedor Int         @id(map: "_provedores__pk") @default(autoincrement())
  entidad      String?     @db.VarChar(30)
  nombre       String?     @db.VarChar(30)
  direccion    String?     @db.VarChar(100)
  cod_postal   String?     @map("cod postal") @db.VarChar(20)
  cuit         String?     @db.VarChar(50)
  telefono     String?     @db.VarChar(60)
  fax          String?     @db.VarChar(50)
  celular      String?     @db.VarChar(50)
  email        String?     @db.VarChar(50)
  contacto     String?     @db.VarChar(150)
  localidad    String?     @db.VarChar(50)
  fecha        DateTime?   @db.Timestamp(6)
  razon_social String?     @db.VarChar(20)
  ARTICULOS    ARTICULOS[]
}

model REMITOS {
  id_remito          Int               @id(map: "_remitos__pk") @default(autoincrement())
  id_sucursal        Int?
  fecha_de_emision   DateTime?         @db.Date
  fecha_de_creacion  DateTime          @default(now()) @db.Date
  id_estado          Int               @default(1)
  id_cliente         Int?
  tipo_comprobante   String?           @default("\"remito\"") @db.VarChar(20)
  cod_remito_final   Int?
  id_moneda          Int?
  total_efectivo     Float
  recargo_financiero Float?
  bonificaciones     Float?
  total_final        Float?
  redondeo           Float?
  cod_mes            Int               @default(dbgenerated("(EXTRACT(month FROM now()))::integer"))
  DETALLES_REMITO    DETALLES_REMITO[]
  PAGOS_REMITO       PAGOS_REMITO[]
  ESTADOS_REMITOS    ESTADOS_REMITOS   @relation(fields: [id_estado], references: [id_estado], onDelete: SetNull, map: "_remitos__estados_remitos_fk")
  CLIENTES           CLIENTES?         @relation(fields: [id_cliente], references: [id_cliente], map: "remitos_clientes_fk")
  MONEDA             MONEDA?           @relation(fields: [id_moneda], references: [id_moneda], map: "remitos_moneda_fk")
  SUCURSAL           SUCURSAL?         @relation(fields: [id_sucursal], references: [id_sucursal], map: "remitos_sucursal_fk")
}

model SUCURSAL {
  id_sucursal     Int             @id(map: "_sucursal__pk") @default(autoincrement())
  nombre_sucursal String?         @db.VarChar(30)
  NUMERO_REMITO   NUMERO_REMITO[]
  REMITOS         REMITOS[]
}

model TIPOS_DE_MEDIDA {
  id_medida   Int         @id(map: "_tipos_de_medida__pk") @default(autoincrement())
  nombre_tipo String?     @db.VarChar(20)
  ARTICULOS   ARTICULOS[]
}

model TIPOS_DE_PAGO {
  id_tipos_de_pago    Int            @id(map: "_tipos_de_pago__pk") @default(autoincrement())
  nombre_tipo_de_pago String         @db.VarChar(20)
  recargo             Float
  signo               Boolean?
  modificable         Boolean        @default(true)
  PAGOS_REMITO        PAGOS_REMITO[]
}

model USUARIOS {
  id_usuario   Int          @id(map: "usuarios_pk") @default(autoincrement())
  nombre       String?      @db.VarChar(20)
  apellido     String?      @db.VarChar(20)
  email        String?      @unique(map: "usuarios_email_key") @db.VarChar(255)
  rol          rol_usuario?
  /// Impresora preseleccionada de este usuario. Solo la usan los roles que
  /// pueden elegir impresora (shared/impresion.json); el resto imprime siempre
  /// en la predeterminada global.
  id_impresora Int?
  IMPRESORAS   IMPRESORAS?  @relation(fields: [id_impresora], references: [id_impresora], onDelete: SetNull, map: "usuarios_impresoras_fk")
}

/// Una fila por cada PC del comercio que corre un printer-client. El
/// print-service rutea cada trabajo al websocket de la impresora que le indica
/// el backend: nunca broadcast.
model IMPRESORAS {
  id_impresora      Int        @id(map: "impresoras_pk") @default(autoincrement())
  nombre            String     @unique(map: "impresoras_nombre_key") @db.VarChar(40)
  /// sha256 hex del token del printer-client. El token en claro no se guarda:
  /// se muestra UNA sola vez, al crear la impresora o al regenerarlo.
  token_hash        String     @unique(map: "impresoras_token_hash_key") @db.VarChar(64)
  activa            Boolean    @default(true)
  /// Destino de todo trabajo que no elige impresora (todos los empleados).
  /// Un indice unico parcial garantiza que haya una sola en true.
  es_predeterminada Boolean    @default(false)
  fecha_creacion    DateTime   @default(now()) @db.Timestamptz(6)
  USUARIOS          USUARIOS[]
}

model GRUPOS_DE_VENTA {
  id_grupo                Int                       @id(map: "grupos_de_venta_pk") @default(autoincrement())
  nombre_grupo            String                    @db.VarChar(50)
  tipo_grupo              tipo_operacion?
  ARTICULOS               ARTICULOS[]
  ARTICULOS_X_GRUPO_VENTA ARTICULOS_X_GRUPO_VENTA[]
  CLIENTES_MAYORISTAS     CLIENTES_MAYORISTAS[]
  SUBGRUPOS_DE_VENTA      SUBGRUPOS_DE_VENTA[]
}

model ARTICULOS_X_GRUPO_VENTA {
  id_reg             Int                 @id(map: "articulos_x_grupo_venta_pk") @default(autoincrement())
  id_articulo        Int
  id_grupo_venta     Int
  id_subgrupo        Int?
  ARTICULOS          ARTICULOS           @relation(fields: [id_articulo], references: [id_articulo], onDelete: Cascade, map: "articulos_x_grupo_venta_alt_articulos_fk")
  GRUPOS_DE_VENTA    GRUPOS_DE_VENTA     @relation(fields: [id_grupo_venta], references: [id_grupo], onDelete: Cascade, map: "articulos_x_grupo_venta_alt_grupos_de_venta_fk")
  SUBGRUPOS_DE_VENTA SUBGRUPOS_DE_VENTA? @relation(fields: [id_subgrupo], references: [id_subgrupo], map: "articulos_x_grupo_venta_alt_subgrupos_de_venta_fk")
}

model SUBGRUPOS_DE_VENTA {
  id_subgrupo             Int                       @id(map: "_subgrupos_de_venta_alt__pk") @default(autoincrement())
  id_grupo                Int
  nombre_subgrupo         String                    @db.VarChar(30)
  ARTICULOS               ARTICULOS[]
  ARTICULOS_X_GRUPO_VENTA ARTICULOS_X_GRUPO_VENTA[]
  GRUPOS_DE_VENTA         GRUPOS_DE_VENTA           @relation(fields: [id_grupo], references: [id_grupo], onDelete: Cascade, map: "subgrupos_de_venta_grupos_de_venta_fk")
}

model ARTICULOS_X_CLIENTE {
  id_registro Int                 @id(map: "articulos_x_cliente_pk") @default(autoincrement())
  id_articulo Int
  id_cliente  Int
  ARTICULOS   ARTICULOS           @relation(fields: [id_articulo], references: [id_articulo], onDelete: Cascade, map: "articulos_x_cliente_articulos_fk")
  CLIENTES    CLIENTES_MAYORISTAS @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade, map: "articulos_x_cliente_clientes_fk")
}

model LINEAS {
  id_linea     Int         @id(map: "lineas_pk") @default(autoincrement())
  nombre_linea String      @db.VarChar(20)
  ARTICULOS    ARTICULOS[]
}

model CLIENTES_MAYORISTAS {
  nombre                String                @db.VarChar(30)
  telefono              String?               @db.VarChar(11)
  email                 String?               @db.VarChar(30)
  razon_social          String?               @db.VarChar(20)
  grupo_venta_exclusivo Int?
  id_cliente            Int                   @id(map: "clientes_alt_pk") @default(autoincrement())
  ARTICULOS_X_CLIENTE   ARTICULOS_X_CLIENTE[]
  GRUPOS_DE_VENTA       GRUPOS_DE_VENTA?      @relation(fields: [grupo_venta_exclusivo], references: [id_grupo], map: "clientes_grupos_de_venta_fk")
}

model CLIENTES {
  id_cliente       Int       @id(map: "_clientes__pk") @default(autoincrement())
  fecha_alta       DateTime  @default(now()) @db.Date
  nombre           String    @db.VarChar(50)
  apellido         String?   @db.VarChar(50)
  dni              String    @db.VarChar(8)
  email            String?   @db.VarChar(50)
  telefono         Int?
  fecha_nacimiento DateTime? @db.Date
  cod_pais         Int?      @default(54) @db.SmallInt
  cod_area         Int?      @default(11) @db.SmallInt
  REMITOS          REMITOS[]
}

model remitos_contador {
  cod_mes       String @id
  ultimo_numero Int    @default(0)
}

model PAGOS_REMITO {
  id_pago         Int           @id(map: "_pagos_remito__pk") @default(autoincrement())
  id_remito       Int
  id_tipo_de_pago Int           @default(1)
  monto_inicial   Float
  monto_final     Float
  REMITOS         REMITOS       @relation(fields: [id_remito], references: [id_remito], onDelete: Cascade, map: "_pagos_remito__remitos_fk")
  TIPOS_DE_PAGO   TIPOS_DE_PAGO @relation(fields: [id_tipo_de_pago], references: [id_tipos_de_pago], onDelete: SetDefault, map: "_pagos_remito__tipos_de_pago_fk")
}

enum tipo_operacion {
  compra
  venta
  X
}

enum rol_usuario {
  empleado
  admin
  superadmin
}
