# Secreto compartido con el backend. TIENE que ser el mismo valor que
# PRINT_SERVICE_SECRET en backend/.env: protege POST /jobs y es lo que este
# servicio presenta para validar los tokens de las impresoras.
# Generarlo con: openssl rand -base64 32
PRINT_SERVICE_SECRET=

# Backend al que se le consultan los tokens. Siempre por localhost: ni este
# servicio ni /interno salen del VPS.
BACKEND_INTERNAL_URL=http://127.0.0.1:5000
